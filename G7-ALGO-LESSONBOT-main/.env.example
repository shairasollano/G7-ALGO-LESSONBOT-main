# AlgoTutor AI — environment configuration (placeholders only, never commit real values)
# Copy to .env and fill in. Every variable has a safe default for local development.

# Server
NODE_ENV=development
PORT=3001
# Comma-separated list of allowed browser origins for CORS (production frontend origin)
CLIENT_ORIGIN=http://localhost:5173

# Client (build-time only — baked into the production bundle, never read at runtime)
# In production, set this to the API origin (e.g. https://api.example.com).
# Leave empty for same-origin development (Vite dev server proxies /api to the backend).
VITE_API_BASE_URL=

# AI provider selection.
#   curated  -> offline curated tutor, always available, no key required (default)
#   gemini   -> Google Gemini adapter. ONLY enable if the responsible project owner has
#               verified that BOTH the developer account and the intended app audience
#               comply with the current Gemini API terms (https://ai.google.dev/gemini-api/terms).
#               The Gemini API terms require users to be 18+ and prohibit API clients
#               directed at or likely to be accessed by individuals under 18.
AI_PROVIDER=curated

# Gemini settings (only read when AI_PROVIDER=gemini). Never put the key in frontend code.
GEMINI_API_KEY=
# Model identifier is configurable; verify against current official docs.
# NOTE (2026-10-18): gemini-2.0-flash returns HTTP 404 "no longer available"; the
# API directs new clients to a current-generation flash model.
# NOTE: gemini-2.0-flash is retired (404). Current example:
GEMINI_MODEL=gemini-3.8-flash

# xKiro provider (OpenAI-compatible Chat Completions).
# Only read when AI_PROVIDER=xkiro. Never put the key in frontend code.
XKIRO_API_KEY=
# Base URL for the OpenAI-compatible API (keep the trailing /v1 path).
XKIRO_BASE_URL=https://api.xkiro.com/v1
# Exact vendor/model identifier selected from the xKiro catalog — required when
# AI_PROVIDER=xkiro; leave empty to keep the provider disabled.
XKIRO_MODEL=

# Optional: explicit owner attestation that the Gemini audience/terms gate has been
# reviewed. The server refuses to enable Gemini without this when set to a truthy value.
# GEMINI_AUDIENCE_COMPLIANCE_ATTESTED=
